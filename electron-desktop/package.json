{
  "name": "shafy-doctor-desktop",
  "version": "1.0.0",
  "description": "Shafy Doctor Desktop Application",
  "main": "main.js",
  "author": "Shafy",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "cd ../ && npm run dev",
    "prebuild": "node copy-build-files.js",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "cd ../ && npm run build",
    "build:electron": "electron-builder",
    "start": "electron .",
    "pack": "npm run prebuild && electron-builder --dir",
    "dist": "npm run prebuild && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.shafy.doctor",
    "productName": "Shafy Doctor",
    "compression": "store",
    "asar": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "database/**/*",
      "services/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/.cache/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/logo.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/logo.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.3.0",
    "arabic-persian-reshaper": "^1.0.1",
    "arabic-reshaper": "^1.1.0",
    "better-sqlite3": "^11.7.0",
    "bidi-js": "^1.0.3",
    "cookie": "^1.0.2",
    "dayjs": "^1.11.18",
    "electron-store": "^10.1.0",
    "firebase": "^12.1.0",
    "framer-motion": "^12.23.24",
    "next": "15.5.7",
    "next-seo": "^6.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "electron": "^32.2.6",
    "concurrently": "^9.1.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  }
}
